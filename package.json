{
  "name": "arcade-games",
  "version": "1.0.0",
  "private": true,
  "description": "Arcade Games: realtime 1v1 simultaneous mind games in the browser (Node.js, Express, socket.io, SVG).",
  "license": "MIT",
  "main": "server/index.js",
  "scripts": {
    "start": "node server/index.js",
    "dev": "node --watch server/index.js",
