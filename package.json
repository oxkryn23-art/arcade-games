    "icons": "node tools/build-icons.js",
    "tutorial-text": "node tools/tutorial-text.js",
    "timing": "node tools/reveal-timing.js",
    "screens": "node tools/screens.js",
    "covers": "node tools/covers.js",
    "build:pages": "node tools/build-pages.js"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "compression": "^1.8.2",
    "express": "^4.21.0",
    "socket.io": "^4.8.0"
  },
  "devDependencies": {
    "lucide-static": "1.66.0",
    "socket.io-client": "^4.8.0"
  }
