# Copy to .env (optional: every value has a safe default).
PORT=3000
# Dev tools: the scene lab at /dev/lab (only from this machine).
DEV_MODE=false
# Optional absolute origin for challenge links, e.g. https://example.com (empty = taken from the request).
PUBLIC_URL=
# A player who loses the connection mid-match has this long to come back (ms).
REJOIN_GRACE_MS=30000
# Show how many players are waiting per game on the Play page.
SHOW_WAITING_COUNTS=true
